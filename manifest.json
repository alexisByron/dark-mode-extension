{
  "manifest_version": 3,
  "name": "Modo Oscuro Forzado",
  "short_name": "Oscuro/Claro",
  "version": "1.0.0",
  "description": "Fuerza modo oscuro o claro en cualquier sitio: lee los estilos de la página y recalcula sus colores.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Modo Oscuro Forzado",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/colors.js", "content/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "toggle-site": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Activar / desactivar en este sitio"
    }
  }
}
